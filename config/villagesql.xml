<?xml version="1.0" encoding="utf-8"?>
<villagesql>
    <connection>
        <vsql_host>127.0.0.1</vsql_host>
        <vsql_port>3306</vsql_port>
        <vsql_socket>/tmp/villagesql.sock</vsql_socket>
        <vsql_ssl>false</vsql_ssl>
        <vsql_ssl_two_way>false</vsql_ssl_two_way>
        <vsql_ssl_linux_capath>/etc/mysql/certs</vsql_ssl_linux_capath>
        <vsql_ssl_windows_capath>C:\mysql\certs</vsql_ssl_windows_capath>
        <vsql_ssl_ca>ca-cert.pem</vsql_ssl_ca>
        <vsql_ssl_cert>client-cert.pem</vsql_ssl_cert>
        <vsql_ssl_key>client-key.pem</vsql_ssl_key>
        <vsql_ssl_cipher>server</vsql_ssl_cipher>
    </connection>
    <tpcc>
        <schema>
            <vsql_count_ware>1</vsql_count_ware>
            <vsql_num_vu>1</vsql_num_vu>
            <vsql_user>root</vsql_user>
            <vsql_pass>mysql</vsql_pass>
            <vsql_dbase>tpcc</vsql_dbase>
            <vsql_storage_engine>innodb</vsql_storage_engine>
            <vsql_partition>false</vsql_partition>
            <vsql_prepared>false</vsql_prepared>
            <vsql_history_pk>false</vsql_history_pk>
            <vsql_no_stored_procs>false</vsql_no_stored_procs>
        </schema>
        <driver>
            <vsql_total_iterations>10000000</vsql_total_iterations>
            <vsql_raiseerror>false</vsql_raiseerror>
            <vsql_keyandthink>false</vsql_keyandthink>
            <vsql_driver>timed</vsql_driver>
            <vsql_rampup>2</vsql_rampup>
            <vsql_duration>5</vsql_duration>
            <vsql_allwarehouse>false</vsql_allwarehouse>
            <vsql_timeprofile>false</vsql_timeprofile>
            <vsql_async_scale>false</vsql_async_scale>
            <vsql_async_client>10</vsql_async_client>
            <vsql_async_verbose>false</vsql_async_verbose>
            <vsql_async_delay>1000</vsql_async_delay>
            <vsql_connect_pool>false</vsql_connect_pool>
        </driver>
    </tpcc>
    <tpch>
        <schema>
            <vsql_scale_fact>1</vsql_scale_fact>
            <vsql_tpch_user>root</vsql_tpch_user>
            <vsql_tpch_pass>mysql</vsql_tpch_pass>
            <vsql_tpch_dbase>tpch</vsql_tpch_dbase>
            <vsql_num_tpch_threads>1</vsql_num_tpch_threads>
            <vsql_tpch_storage_engine>innodb</vsql_tpch_storage_engine>
        </schema>
        <driver>
            <vsql_total_querysets>1</vsql_total_querysets>
            <vsql_raise_query_error>false</vsql_raise_query_error>
            <vsql_verbose>false</vsql_verbose>
            <vsql_refresh_on>false</vsql_refresh_on>
            <vsql_update_sets>1</vsql_update_sets>
            <vsql_trickle_refresh>1000</vsql_trickle_refresh>
            <vsql_refresh_verbose>false</vsql_refresh_verbose>
            <vsql_cloud_query>false</vsql_cloud_query>
        </driver>
    </tpch>
</villagesql>
